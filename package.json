    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "d3-geo": "^3.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "i18n-iso-countries": "^7.14.0",
    "tailwindcss": "4.3.3",
    "topojson-client": "^3.1.0",
